# --- Base de datos (Supabase > Project Settings > Database > Connection string > Transaction pooler) ---
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# --- Acceso a la web (clave compartida del grupo) ---
CLAVE_GRUPO=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secreto que Telegram envia en la cabecera X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# URL publica de la app (para los enlaces en los mensajes del bot)
APP_URL=https://tu-app.vercel.app
